{
  "name": "nikke-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "fetch-data": "npm run fetch-data -w @nikke/core",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tools/tsconfig.json",
    "dev": "npm run dev -w @nikke/web",
    "build": "npm run build -w @nikke/web",
    "preview": "npm run preview -w @nikke/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim": "node packages/core/scripts/sim-run.ts",
    "records:table": "node packages/core/scripts/records-table.ts && prettier --write plan/captures/recordings.md records/recordings",
    "records:check": "node packages/core/scripts/records-check.ts && prettier --write plan/residuals.md plan/claims.md records/claims"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
