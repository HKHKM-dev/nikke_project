{
  "name": "nikke-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "fetch-data": "npm run fetch-data -w @nikke/core --",
    "fetch-data:diff": "node packages/core/scripts/data-diff.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tools/tsconfig.json",
    "dev": "npm run dev -w @nikke/web",
    "build": "npm run build -w @nikke/web",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "preview": "npm run preview -w @nikke/web",
    "artifact:build": "node tools/artifact/build.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim": "node packages/core/scripts/sim-run.ts",
    "records:table": "node packages/core/scripts/records-table.ts && node tools/format-retry.ts records/recordings",
    "records:check": "node packages/core/scripts/records-table.ts && node packages/core/scripts/skill-catalog.ts && node packages/core/scripts/records-check.ts && node tools/format-retry.ts plan/claims.md plan/verifications.md plan/skills.md plan/minimal.md records/claims records/verifications records/recordings",
    "records:residual": "node packages/core/scripts/records-residual.ts",
    "records:read": "node tools/captures/read.ts",
    "records:minimal": "node packages/core/scripts/records-minimal.ts && node tools/format-retry.ts records/minimal && npm run records:check",
    "records:predict": "node packages/core/scripts/records-predict.ts",
    "records:new": "node packages/core/scripts/records-new.ts",
    "records:close": "node packages/core/scripts/records-close.ts",
    "records:renumber": "node packages/core/scripts/records-renumber.ts",
    "pr:prep": "node tools/git/pr-prep.ts",
    "build:import": "node tools/builds/import.ts",
    "build:fetch": "node tools/builds/fetch.ts",
    "drive:sync": "node tools/drive/sync.ts",
    "drive:conflicts": "node tools/drive/sync.ts --conflicts",
    "drive:gateway-check": "node tools/drive/gateway-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
